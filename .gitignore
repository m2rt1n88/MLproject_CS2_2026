# ============================================================
# CS2 比赛预测 —— 要共享给队友的文件都进仓库
# 原则：只忽略 ① 本机私有 ② 可再生成 ③ 别人的代码
# 数据（data/raw/*.csv、data/processed/*.csv）和报告是要共享的，不忽略。
# ============================================================

# ---------- Python 环境 / 运行缓存 ----------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
build/
dist/

# ---------- 操作系统 / 编辑器垃圾 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# ---------- 密钥，千万别进仓库 ----------
.env
.env.*
!.env.example
*.pem
*.key
kaggle.json

# ---------- 正式 M1/M2 权重随仓库交付，其余模型默认不提交 ----------
/models/*
!/models/m1/
!/models/m2/
!/models/lstm_release/
/models/m1/*
/models/m2/*
*.pkl
*.joblib
!/models/m1/random_forest.joblib
!/models/m2/m2_clean_retuned.joblib
logs/
runs/
*.log

# ---------- 第三方参考项目：不打包本机下载的代码和数据库 ----------
# 正式模型不依赖这些项目；部分参考项目可用 scripts/download_reference_projects.py 下载。
# 只保留我们自己写的说明文件，方便知道 references/ 里该有什么。
references/*
!references/README.md

# ---------- 下载的压缩包：解压后的 CSV 已经进仓库 ----------
data/raw/*.zip

# ---------- 队友交付：忽略导出的整包，保留项目中的 M3 实验归档 ----------
/team_packages/

# Office 打开的临时锁文件不随正式课程文档一起交付
~$*.docx
~$*.xlsx
~$*.pptx

# V2 partner delivery outputs are reproducible; commit only the source docs and snapshots.
/handoff/CS2-v2-*/
/handoff/CS2-v2-*.zip
